-- ====== ФУНКЦИЯ ДОБАВЛЕНИЯ ТУМБЛЕРА ======
local function addToggle(name, key)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -10, 0, 22)
    btn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    btn.Text = name .. ": off"
    btn.TextColor3 = Color3.fromRGB(200, 200, 200)
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 10
    btn.Parent = scroll
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)
    btn.MouseButton1Click:Connect(function()
        flags[key] = not flags[key]
        btn.Text = name .. ": " .. (flags[key] and "on" or "off")
        btn.BackgroundColor3 = flags[key] and Color3.fromRGB(0, 100, 60) or Color3.fromRGB(40, 40, 40)
        
        -- Логика включения/выключения
        if key == "silentaim" then
            killBtn.Visible = flags.silentaim
        elseif key == "invisible" then
            local char = LP.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hrp then
                if flags.invisible then
                    hrp.CFrame = CFrame.new(0, -300, 0) -- Под карту
                    hrp.Anchored = true
                    Camera.CameraSubject = nil
                    Camera.CFrame = CFrame.new(0, 50, 0) -- Камера наверху
                else
                    hrp.Anchored = false
                    Camera.CameraSubject = char:FindFirstChildOfClass("Humanoid")
                    if char:FindFirstChild("HumanoidRootPart") then
                        char.HumanoidRootPart.CFrame = CFrame.new(0, 5, 0) -- Возврат на спавн (примерно)
                    end
                end
            end
        end
    end)
end

