-- ====== TOUCH FLING ======
local flingLoop = nil
local isFlinging = false

local function getNearestPlayer()
    local myChar = LP.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHrp then return nil end
    
    local closest = nil
    local shortest = 10
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and plr.Character then
            local tHrp = plr.Character:FindFirstChild("HumanoidRootPart")
            local tHum = plr.Character:FindFirstChildOfClass("Humanoid")
            if tHrp and tHum and tHum.Health > 0 then
                local dist = (tHrp.Position - myHrp.Position).Magnitude
                if dist < shortest then
                    shortest = dist
                    closest = plr
                end
            end
        end
    end
    return closest
end

local function startFling()
    if isFlinging then return end
    isFlinging = true
    
    flingLoop = RunService.Heartbeat:Connect(function()
        local myChar = LP.Character
        local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
        local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
        if not (myHrp and myHum) then return end
        
        local target = getNearestPlayer()
        if not target then return end
        
        local tChar = target.Character
        local tHrp = tChar and tChar:FindFirstChild("HumanoidRootPart")
        local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
        if not (tHrp and tHum) then return end
        
        myHrp.CanCollide = false
        myHrp.Anchored = true
        
        myHrp.CFrame = tHrp.CFrame
        
        tHrp.CanCollide = false
        tHum.PlatformStand = true
        
        tHrp.AssemblyLinearVelocity = Vector3.new(
            math.random(-5000, 5000),
            math.random(5000, 10000),
            math.random(-5000, 5000)
        )
        tHrp.AssemblyAngularVelocity = Vector3.new(
            math.random(-5000, 5000),
            math.random(-5000, 5000),
            math.random(-5000, 5000)
        )
        
        task.wait(0.1)
        myHrp.Anchored = false
        myHrp.CanCollide = true
    end)
end

local function stopFling()
    isFlinging = false
    if flingLoop then flingLoop:Disconnect(); flingLoop = nil end
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and plr.Character then
            local tHrp = plr.Character:FindFirstChild("HumanoidRootPart")
            local tHum = plr.Character:FindFirstChildOfClass("Humanoid")
            if tHrp then
                tHrp.CanCollide = true
                tHrp.AssemblyLinearVelocity = Vector3.zero
                tHrp.AssemblyAngularVelocity = Vector3.zero
            end
            if tHum then
                tHum.PlatformStand = false
            end
        end
    end
end

for _, child in ipairs(scroll:GetChildren()) do
    if child:IsA("TextButton") and child.Text:find("touch fling") then
        child.MouseButton1Click:Connect(function()
            if flags.touchfling then
                startFling()
            else
                stopFling()
            end
        end)
    end
end

-- ====== ESP ======
local espFolder = Instance.new("Folder", gui)
local espCache = {}

RunService.RenderStepped:Connect(function()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LP then continue end
        local char = plr.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local data = espCache[plr]
        
        if not flags.esp or not (hrp and hum and hum.Health > 0) then
            if data then data.box.Visible = false; data.hpBack.Visible = false end
            continue
        end

        local isMurder, isSherif = false, false
        if game.PlaceId == 142823291 then
            for _, obj in ipairs(char:GetChildren()) do
                if obj:IsA("Tool") then
                    if obj.Name == "Knife" then isMurder = true end
                    if obj.Name == "Gun" or obj.Name == "Revolver" then isSherif = true end
                end
            end
            local bp = plr:FindFirstChild("Backpack")
            if bp then
                for _, obj in ipairs(bp:GetChildren()) do
                    if obj:IsA("Tool") then
                        if obj.Name == "Knife" then isMurder = true end
                        if obj.Name == "Gun" or obj.Name == "Revolver" then isSherif = true end
                    end
                end
            end
        end

        local color = Color3.fromRGB(255, 255, 255)
        if isMurder then color = Color3.fromRGB(255, 40, 40) end
        if isSherif then color = Color3.fromRGB(40, 140, 255) end

        if not data then
            local box = Instance.new("Frame", espFolder)
            box.BackgroundTransparency = 1; box.BorderSizePixel = 0
            local s = Instance.new("UIStroke", box)
            s.Thickness = 1.5; s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
            local hpBack = Instance.new("Frame", espFolder)
            hpBack.BackgroundColor3 = Color3.fromRGB(0, 0, 0); hpBack.BorderSizePixel = 0
            local hpFill = Instance.new("Frame", hpBack)
            hpFill.BorderSizePixel = 0
            data = { box = box, stroke = s, hpBack = hpBack, hpFill = hpFill }
            espCache[plr] = data
        end

        local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
        if onScreen then
            local dist = (Camera.CFrame.Position - hrp.Position).Magnitude
            local h = math.clamp(1800 / math.max(dist, 1), 20, 300)
            local w = h * 0.55
            data.box.Visible = true; data.hpBack.Visible = true
            data.box.Size = UDim2.fromOffset(w, h)
            data.box.Position = UDim2.fromOffset(pos.X - w/2, pos.Y - h/2)
            data.stroke.Color = color
            local hpRatio = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
            data.hpBack.Size = UDim2.fromOffset(w, 4)
            data.hpBack.Position = UDim2.fromOffset(pos.X - w/2, pos.Y - h/2 - 6)
            data.hpFill.Size = UDim2.new(hpRatio, 0, 1, 0)
            data.hpFill.BackgroundColor3 = hpRatio > 0.6 and Color3.fromRGB(0,255,0) or (hpRatio > 0.3 and Color3.fromRGB(255,165,0) or Color3.fromRGB(255,0,0))
        else
            data.box.Visible = false; data.hpBack.Visible = false
        end
    end
end)
