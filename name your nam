-- ====== SILENT AIM (Kill Murder по кнопке) ======
local function getMurder()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LP then continue end
        local char = plr.Character
        if not char then continue end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not (hum and hum.Health > 0) then continue end
        for _, tool in ipairs(char:GetChildren()) do
            if tool:IsA("Tool") and tool.Name == "Knife" then return plr end
        end
        local bp = plr:FindFirstChild("Backpack")
        if bp then for _, tool in ipairs(bp:GetChildren()) do if tool:IsA("Tool") and tool.Name == "Knife" then return plr end end end
    end
end

