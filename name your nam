-- ====== ESP BOX ======
local espFolder = Instance.new("Folder", gui)
local espCache = {}

RunService.RenderStepped:Connect(function()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LP then continue end
        local char = plr.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local data = espCache[plr]
        
        if not flags.espBox or not (hrp and hum and hum.Health > 0) then
            if data then data.box.Visible = false; data.hpBack.Visible = false end
            continue
        end

        local isMurder, isSherif = false, false
        for _, obj in ipairs(char:GetChildren()) do
            if obj:IsA("Tool") then
                if obj.Name == "Knife" then isMurder = true end
                if obj.Name == "Gun" or obj.Name == "Revolver" then isSherif = true end
            end
        end
        local backpack = plr:FindFirstChild("Backpack")
        if backpack then
            for _, obj in ipairs(backpack:GetChildren()) do
                if obj:IsA("Tool") then
                    if obj.Name == "Knife" then isMurder = true end
                    if obj.Name == "Gun" or obj.Name == "Revolver" then isSherif = true end
                end
            end
        end

        local color = Color3.fromRGB(255, 255, 255)
        if isMurder then color = Color3.fromRGB(255, 40, 40) end
        if isSherif then color = Color3.fromRGB(40, 140, 255) end

        if not data then
            local box = Instance.new("Frame")
            box.BackgroundTransparency = 1; box.BorderSizePixel = 0; box.Parent = espFolder
            local s = Instance.new("UIStroke", box)
            s.Thickness = 1.5; s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
            local hpBack = Instance.new("Frame", espFolder)
            hpBack.BackgroundColor3 = Color3.fromRGB(0, 0, 0); hpBack.BorderSizePixel = 0
            local hpFill = Instance.new("Frame", hpBack)
            hpFill.BorderSizePixel = 0
            data = { box = box, stroke = s, hpBack = hpBack, hpFill = hpFill }
            espCache[plr] = data
        end

        local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
        if onScreen then
            local dist = (Camera.CFrame.Position - hrp.Position).Magnitude
            local h = math.clamp(1800 / math.max(dist, 1), 20, 300)
            local w = h * 0.55
            data.box.Visible = true; data.hpBack.Visible = true
            data.box.Size = UDim2.fromOffset(w, h)
            data.box.Position = UDim2.fromOffset(pos.X - w/2, pos.Y - h/2)
            data.stroke.Color = color
            local hpRatio = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
            data.hpBack.Size = UDim2.fromOffset(w, 4)
            data.hpBack.Position = UDim2.fromOffset(pos.X - w/2, pos.Y - h/2 - 6)
            data.hpFill.Size = UDim2.new(hpRatio, 0, 1, 0)
            data.hpFill.BackgroundColor3 = hpRatio > 0.6 and Color3.fromRGB(0,255,0) or (hpRatio > 0.3 and Color3.fromRGB(255,165,0) or Color3.fromRGB(255,0,0))
        else
            data.box.Visible = false; data.hpBack.Visible = false
        end
    end
end)

-- ====== AIMBOT ======
local function getMurder()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LP then continue end
        local char = plr.Character
        if not char then continue end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not (hum and hum.Health > 0) then continue end
        for _, tool in ipairs(char:GetChildren()) do
            if tool:IsA("Tool") and tool.Name == "Knife" then return plr end
        end
        local bp = plr:FindFirstChild("Backpack")
        if bp then for _, tool in ipairs(bp:GetChildren()) do if tool:IsA("Tool") and tool.Name == "Knife" then return plr end end end
    end
end

RunService.RenderStepped:Connect(function()
    if not flags.aimbot then return end
    local char = LP.Character
    if not char then return end
    local hasGun = false
    for _, tool in ipairs(char:GetChildren()) do if tool:IsA("Tool") and (tool.Name == "Gun" or tool.Name == "Revolver") then hasGun = true end end
    if not hasGun then return end
    local target = getMurder()
    if not target then return end
    local tHead = target.Character and target.Character:FindFirstChild("Head")
    if tHead then Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, tHead.Position) end
end)

-- ====== ANTIAIM / SPEED / JUMP ======
RunService.RenderStepped:Connect(function()
    if not flags.antiaim then return end
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(math.random(0, 360)), 0) end
end)

RunService.Stepped:Connect(function()
    local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.WalkSpeed = flags.speedX2 and 32 or 16
        hum.UseJumpPower = true
        hum.JumpPower = flags.jumpX2 and 100 or 50
    end
end)

-- ====== FUSION FLING (Слияние и Возврат) ======
local flinging = false
local flingCD = {}

RunService.Stepped:Connect(function()
    if not flags.blinkFling or flinging then return end
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    -- Ищем жертву (касание)
    local targetPlr, targetHrp = nil, nil
    local shortest = 5 -- Радиус касания

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LP then continue end
        local tChar = plr.Character
        local tHrp = tChar and tChar:FindFirstChild("HumanoidRootPart")
        if tHrp then
            local dist = (tHrp.Position - hrp.Position).Magnitude
            if dist < shortest then
                shortest = dist
                targetPlr = plr
                targetHrp = tHrp
            end
        end
    end

    if targetPlr and targetHrp and not flingCD[targetPlr] then
        flingCD[targetPlr] = true
        flinging = true

        task.spawn(function()
            -- 1. Запоминаем нашу позицию
            local originalCFrame = hrp.CFrame
            
            -- 2. ВЛЕТАЕМ ВНУТРЬ (сливаемся)
            hrp.CFrame = targetHrp.CFrame
            hrp.CanCollide = false
            
            -- 3. ЖДЕМ 0.2 СЕКУНДЫ (чтобы визуально "залезть" в него)
            task.wait(0.2)
            
            -- 4. ФЛИНГ (Даем скорость ВАМ ОБОИМ)
            local bv = Instance.new("BodyVelocity")
            bv.Velocity = Vector3.new(0, 5000, 0) -- Скорость в космос
            bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            
            local bav = Instance.new("BodyAngularVelocity")
            bav.AngularVelocity = Vector3.new(99999, 99999, 99999)
            bav.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
            
            -- Вешаем на нас обоих
            bv.Parent = hrp
            bav.Parent = hrp
            
            local tBv = bv:Clone()
            local tBav = bav:Clone()
            tBv.Parent = targetHrp
            tBav.Parent = targetHrp
            
            -- 5. ЖДЕМ 0.5 СЕКУНДЫ (летим вместе)
            task.wait(0.5)
            
            -- 6. ОТЦЕПЛЯЕМСЯ И ВОЗВРАЩАЕМСЯ
            hrp.CFrame = originalCFrame
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
            hrp.CanCollide = true
            
            -- Удаляем наши эффекты (у жертвы оставляем, чтобы он летел дальше)
            bv:Destroy()
            bav:Destroy()
            
            flinging = false
            task.wait(1) -- Кулдаун на себя
            flingCD[targetPlr] = nil
        end)
    end
end)

