        end
    end
end)

-- ====== REWIND (Отмотка на 3 сек по клавише E) ======
UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.KeyCode == Enum.KeyCode.E and not rewindActive then
        rewindActive = true
        local char = LP.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then rewindActive = false return end
        
        -- Ищем точки 3 секунды назад
        local pointsToRewind = {}
        for i, data in ipairs(recordedPositions) do
            if tick() - data.time <= 3 then
                table.insert(pointsToRewind, data)
            end
        end
        
        if #pointsToRewind > 0 then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then hum.PlatformStand = true end
            
            -- Проигрываем в обратном порядке (от старых к новым)
            for i = #pointsToRewind, 1, -1 do
                local p = pointsToRewind[i]
                hrp.CFrame = p.cframe
                RunService.Heartbeat:Wait()
            end
            
            if hum then hum.PlatformStand = false end
        end
        rewindActive = false
    end
end)

-- Запись позиций для Rewind
RunService.Heartbeat:Connect(function()
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then
        table.insert(recordedPositions, { time = tick(), cframe = hrp.CFrame })
        -- Чистим старые записи (старше 10 сек), чтобы не забивать память
        if #recordedPositions > 100 then
            table.remove(recordedPositions, 1)
        end
    end
end)
